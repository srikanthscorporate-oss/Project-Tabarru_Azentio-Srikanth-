# Copy to .env and adjust. Nothing here is required: with no variables set the
# deterministic offline FakeProvider is used.

# fake (default) or openai (any OpenAI-compatible endpoint: Ollama, Groq, OpenRouter)
CLAIMS_PROVIDER=fake

# Only read when CLAIMS_PROVIDER=openai
CLAIMS_LLM_BASE_URL=http://localhost:11434/v1
CLAIMS_LLM_MODEL=llama3.1
CLAIMS_LLM_API_KEY=
CLAIMS_LLM_TIMEOUT_S=60

# Storage and certificate register used by the API
CLAIMS_DB=data/claims.db
CLAIMS_REGISTER=data/policies.jsonl

# Document classification only (extraction and coverage always use CLAIMS_PROVIDER).
# llm (default), trained (no classification LLM calls) or hybrid (LLM only when the
# trained model's top probability is below the threshold). trained and hybrid need
# the model built by: python -m claims.train_classifier
CLAIMS_CLASSIFIER=llm
CLAIMS_CLASSIFIER_MODEL=models/doc_classifier.joblib
# Optional override; by default the threshold stored in the model is used
CLAIMS_HYBRID_THRESHOLD=
